---
---

<section class="relative z-10 bg-transparent lg:max-w-[1080px] mx-auto secTabs">
  <div class="container flex flex-col gap-6 lg:gap-10">
    <div class="flex flex-col gap-3 xl:max-w-[760px] mx-auto">
      <h2 class="font-amx-bold font-bold text-center text-2xl md:text-3xl">
        Descubre la experiencia con
        <img
          src="https://www.claro.com.pe/assets/havas/liga-1-max/assets/icon-l1max-sincostov2.png"
          alt="Liga L1 Max"
          width="80"
          style="display: inline"
        />
      </h2>
      <div class="text-center font-amx-regular text-base lg:text-lg">
        Todo el futbol peruano y el brasileirão.
      </div>
    </div>
    <div class="contentTabs">
      <div class="tab active" cat="SOY HOGAR">SOY HOGAR</div>
      <div class="tab " cat="SOY POSTPAGO">SOY POSTPAGO</div>
    </div>
  </div>
</section>

<style>
  section.secTabs h2 {
    align-items: center;
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  @media (max-width: 500px) {
    section.secTabs h2 {
      flex-direction: column;
    }
  }

  @media (max-width: 1599px) {
    section.secTabs {
      padding-top: 100px !important;
    }
  }

  .contentTabs {
    max-width: 435px;
    width: 100%;
    display: flex;
    background-color: #fff;
    border-radius: 28.5px;
    margin: 0 auto;
    box-shadow: 0 0 8px 0 rgba(0, 0, 0, 0.25);
  }
  .contentTabs .tab {
    width: 50%;
    color: #da291c;
    text-align: center;
    font-family: Roboto;
    font-size: 16px;
    font-weight: 700;
    line-height: normal;
    border-radius: 28.5px;
    padding: 11px 0;
    cursor: pointer;
  }
  .contentTabs .tab.active {
    color: #fff;
    background-color: #da291c;
  }
  @media (max-width: 1023px) {
    .contentTabs {
      margin-top: 10px;
    }
  }
</style>

<script type="module">
  document.addEventListener("DOMContentLoaded", () => {
    const s = document.querySelectorAll(".contentTabs .tab"),
      l = document.querySelectorAll(".contentInfoTabs .content"),
      i = (t) => {
        setTimeout(() => {
          const e = document.querySelector("section.c08.pB30"),
            o = document.querySelector("section.c08.pT30"),
            a = document.querySelectorAll("section.c08");
          (t === "SOY POSTPAGO" &&
            (a.forEach((c) => c.classList.add("ocultarPlanes")),
            e && e.classList.remove("ocultarPlanes")),
            t === "SOY HOGAR" &&
              (a.forEach((c) => c.classList.add("ocultarPlanes")),
              o && o.classList.remove("ocultarPlanes")));
        }, 300);
      };
    s.forEach((t) => {
      t.addEventListener("click", () => {
        const e = t.getAttribute("cat");
        (s.forEach((c) => c.classList.remove("active")),
          t.classList.add("active"),
          l.forEach((c) => c.classList.remove("active")));
        const o = document.querySelector(
          `.contentInfoTabs .content[cat="${e}"]`,
        );
        (o && o.classList.add("active"), i(e));
        const a = new CustomEvent("cambiarTutorialL1Max", {
          detail: {
            tipo: e === "SOY POSTPAGO" ? "L1MAX MOVIL" : "L1 MAX",
          },
          bubbles: !0,
        });
        document.dispatchEvent(a);
      });
    });
    const n = document.querySelector(".contentTabs .tab.active");
    if ((n && i(n.getAttribute("cat")), n)) {
      const t = n.getAttribute("cat"),
        e = new CustomEvent("cambiarTutorialL1Max", {
          detail: {
            tipo: t === "SOY POSTPAGO" ? "L1MAX MOVIL" : "L1 MAX",
          },
          bubbles: !0,
        });
      setTimeout(() => {
        document.dispatchEvent(e);
      }, 500);
    }

    const query = window.location.search.replace("?", "").replace(/\/$/, "").toLowerCase();

    const secTabs = document.querySelector(".secTabs");
    if (!secTabs) return;

    const scrollToTabs = () => {
      const y =
        secTabs.getBoundingClientRect().top +
        window.pageYOffset -
        100;

      window.scrollTo({
        top: y,
        behavior: "smooth"
      });
    };

    const clickTab = (selector) => {
      const tab = document.querySelector(selector);
      if (tab) tab.click();
    };

    if (query === "=movil") {
      scrollToTabs();
      setTimeout(() => {
        clickTab('.tab[cat="SOY POSTPAGO"]');
      }, 500);
    }

    if (query === "=hogar") {
      scrollToTabs();
      setTimeout(() => {
        clickTab('.tab[cat="SOY HOGAR"]');
      }, 500);
    }
  });
</script>

---
import "swiper/css/bundle";
---

<section
  class="tutorialTabs bg-transparent xl:pt-10 bg-gradient-to-b from-white to-transparent"
>
  <img
    class="hidden lg:block absolute -right-6 -top-30 z-20 animate-rotating blur-xs"
    src="https://www.claro.com.pe/assets/havas/landing-deportes/liga1/assets/general/ball-l.png"
    alt="Ball image | Claro Perú"
  />
  <div id="tutorial"></div>
  <div class="container">
    <h2
      id="title_tutorial_slider"
      class="font-amx-bold font-bold text-center text-2xl md:text-3xl"
    >
      Sigue los pasos para activar <span class="text-claro">L1MAX Móvil</span>
    </h2>
    <div class="tabs principal hidden">
      <div class="tab active" data-tab="L1MAX MOVIL">SOY POSTPAGO</div>
      <div class="tab" data-tab="L1 MAX">SOY HOGAR</div>
    </div>
    <div class="checks hidden" data-tab="L1MAX MOVIL">
      <div>
        <img
          src="https://www.claro.com.pe/assets/havas/claro-video/assets/icon.png"
          alt="Icono de un check"
        />
        <p>Míralo desde tu dispositivo móvil.</p>
      </div>
      <div>
        <img
          src="https://www.claro.com.pe/assets/havas/claro-video/assets/icon.png"
          alt="Icono de un check"
        />
        <p>Disfrútalo sin costo adicional si tu plan postpago Max lo incluye.</p>
      </div>
    </div>
    <div class="checks hidden" data-tab="L1 MAX">
      <div>
        <img
          src="https://www.claro.com.pe/assets/havas/claro-video/assets/icon.png"
          alt="Icono de un check"
        />
        <p>Míralo desde tu cel, tablet o compu.</p>
      </div>
      <div>
        <img
          src="https://www.claro.com.pe/assets/havas/claro-video/assets/icon.png"
          alt="Icono de un check"
        />
        <p>Disfrútalo hasta en 2 dispositivos en simultáneo.</p>
      </div>
      <div>
        <img
          src="https://www.claro.com.pe/assets/havas/claro-video/assets/icon.png"
          alt="Icono de un check"
        />
        <p>Disfrútalo sin costo adicional si tu plan hogar lo incluye.</p>
      </div>
    </div>
    <div class="selectTabs" data-tab="L1MAX MOVIL">
      <select name="" id="">
        <option value="tutorialDedeAppAndroid">Sin cuenta de Claro Video</option>
        <option value="tutorialDedeWebConPago">Con cuenta de Claro Video</option>
      </select>
      <img
        class="icon"
        src="https://www.claro.com.pe/assets/havas/claro-video/assets/select.png"
        alt="Icono de Selector"
      />
    </div>
    <div class="selectTabs" data-tab="L1 MAX">
      <select name="" id="">
        <option value="tutorialDedeWebConPago">Con cuenta de Claro Video</option>
      </select>
      <img
        class="icon"
        src="https://www.claro.com.pe/assets/havas/claro-video/assets/select.png"
        alt="Icono de Selector"
      />
    </div>
  </div>

  <!-- HOGAR - 6 pasos -->
  <div class="contentTutorial2 hogar active" data-tab="L1 MAX">
    <div class="part1">
      <div class="swiper sliderTutorial22">
        <div class="swiper-wrapper">
          <div class="swiper-slide item">
            <img src="https://www.claro.com.pe/assets/havas/liga-1-max/_assets/tutorialhogar1.webp" alt="" />
          </div>
          <div class="swiper-slide item">
            <img src="https://www.claro.com.pe/assets/havas/liga-1-max/_assets/tutorialhogar2.webp" alt="" />
          </div>
          <div class="swiper-slide item">
            <img src="https://www.claro.com.pe/assets/havas/liga-1-max/_assets/tutorialhogar3.webp" alt="" />
          </div>
          <div class="swiper-slide item">
            <img src="https://www.claro.com.pe/assets/havas/liga-1-max/_assets/tutorialhogar4.webp" alt="" />
          </div>
          <div class="swiper-slide item">
            <img src="https://www.claro.com.pe/assets/havas/liga-1-max/_assets/tutorialhogar5.webp" alt="" />
          </div>
          <div class="swiper-slide item">
            <img src="https://www.claro.com.pe/assets/havas/liga-1-max/_assets/tutorialhogar6.webp" alt="" />
          </div>
        </div>
      </div>
    </div>
    <div class="part2">
      <div class="content">
        <div class="info active">
          <p class="numero"><strong>Paso 01</strong> / 6</p>
          <p class="titulo">Llama al 080000123, ingresa tu DNI o RUC y marca la opción 2 para actualizar/registrar tu correo.</p>
        </div>
        <div class="info">
          <p class="numero"><strong>Paso 02</strong> / 6</p>
          <p class="titulo">Luego, descarga el app Claro video e inicia sesión con tu nuevo correo.</p>
        </div>
        <div class="info">
          <p class="numero"><strong>Paso 03</strong> / 6</p>
          <p class="titulo">Haz clic en "¿Olvidaste tu contraseña?".</p>
        </div>
        <div class="info">
          <p class="numero"><strong>Paso 04</strong> / 6</p>
          <p class="titulo">En el correo que te enviaremos, haz clic en "Iniciar sesión".</p>
        </div>
        <div class="info">
          <p class="numero"><strong>Paso 05</strong> / 6</p>
          <p class="titulo">Ingresa al perfil de Administrador y crea tu nueva contraseña ¡Listo!.</p>
        </div>
        <div class="info">
          <p class="numero"><strong>Paso 06</strong> / 6</p>
          <p class="titulo">Ve a "inicio" y haz clic en el banner de "L1MAX" para disfrutar tus partidos.</p>
        </div>
        <div class="flechas">
          <div class="swiper-button-prev">
            <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 50 50" fill="none">
              <path d="M25 1.75C37.8406 1.75 48.25 12.1594 48.25 25C48.25 37.8406 37.8406 48.25 25 48.25C12.1594 48.25 1.75 37.8406 1.75 25C1.75 12.1594 12.1594 1.75 25 1.75Z" stroke="#DA291C" stroke-width="3.5"></path>
              <path d="M12.75 25H37.25" stroke="#DA291C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M25 12.75L37.25 25L25 37.25" stroke="#DA291C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <div class="swiper-button-next">
            <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 50 50" fill="none">
              <path d="M25 1.75C37.8406 1.75 48.25 12.1594 48.25 25C48.25 37.8406 37.8406 48.25 25 48.25C12.1594 48.25 1.75 37.8406 1.75 25C1.75 12.1594 12.1594 1.75 25 1.75Z" stroke="#DA291C" stroke-width="3.5"></path>
              <path d="M12.75 25H37.25" stroke="#DA291C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M25 12.75L37.25 25L25 37.25" stroke="#DA291C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MOVIL - 5 pasos -->
  <div class="contentTutorial2 movil" data-tab="L1MAX MOVIL">
    <div class="part1">
      <div class="swiper sliderTutorial2">
        <div class="swiper-wrapper">
          <div class="swiper-slide item">
            <img src="https://www.claro.com.pe/assets/havas/liga-1-max/_assets/tutorialmovil1.webp" alt="" />
          </div>
          <div class="swiper-slide item">
            <img src="https://www.claro.com.pe/assets/havas/liga-1-max/_assets/tutorialmovil2.webp" alt="" />
          </div>
          <div class="swiper-slide item">
            <img src="https://www.claro.com.pe/assets/havas/liga-1-max/_assets/tutorialmovil3.gif" alt="" />
          </div>
          <div class="swiper-slide item">
            <img src="https://www.claro.com.pe/assets/havas/liga-1-max/_assets/tutorialmovil4.gif" alt="" />
          </div>
          <div class="swiper-slide item">
            <img src="https://www.claro.com.pe/assets/havas/liga-1-max/_assets/tutorialmovil5.gif" alt="" />
          </div>
        </div>
      </div>
    </div>
    <div class="part2">
      <div class="content">
        <div class="info active">
          <p class="numero"><strong>Paso 01</strong> / 5</p>
          <p class="titulo">Ingresa a la página web <a href="https://www.clarovideo.com" target="_blank">www.clarovideo.com</a> y regístrate.</p>
        </div>
        <div class="info">
          <p class="numero"><strong>Paso 02</strong> / 5</p>
          <p class="titulo">Ingresa un correo electrónico.</p>
          <p class="descripcion">*Si te aparece un mensaje indicando que tu correo ya está vinculado a nuestra base de datos, <b>llama al 123</b> para ayudarte.</p>
        </div>
        <div class="info">
          <p class="numero"><strong>Paso 03</strong> / 5</p>
          <p class="titulo">Haz clic en el banner de L1MAX Móvil y suscríbete. ¡Tranqui no te cobraremos!</p>
        </div>
        <div class="info">
          <p class="numero"><strong>Paso 04</strong> / 5</p>
          <p class="titulo">En agregar medio de pago, elige "Línea móvil Claro" e ingresa tu número.</p>
        </div>
        <div class="info">
          <p class="numero"><strong>Paso 05</strong> / 5</p>
          <p class="titulo">Ingresa tu código de validación, haz clic en "Contratar". Recuerda, no te cobraremos.</p>
        </div>
        <div class="flechas">
          <div class="swiper-button-prev">
            <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 50 50" fill="none">
              <path d="M25 1.75C37.8406 1.75 48.25 12.1594 48.25 25C48.25 37.8406 37.8406 48.25 25 48.25C12.1594 48.25 1.75 37.8406 1.75 25C1.75 12.1594 12.1594 1.75 25 1.75Z" stroke="#DA291C" stroke-width="3.5"></path>
              <path d="M12.75 25H37.25" stroke="#DA291C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M25 12.75L37.25 25L25 37.25" stroke="#DA291C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <div class="swiper-button-next">
            <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 50 50" fill="none">
              <path d="M25 1.75C37.8406 1.75 48.25 12.1594 48.25 25C48.25 37.8406 37.8406 48.25 25 48.25C12.1594 48.25 1.75 37.8406 1.75 25C1.75 12.1594 12.1594 1.75 25 1.75Z" stroke="#DA291C" stroke-width="3.5"></path>
              <path d="M12.75 25H37.25" stroke="#DA291C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M25 12.75L37.25 25L25 37.25" stroke="#DA291C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <p class="tutorialPie hogar active" data-tab="L1 MAX">
    <b>Recuerda:</b> Si tienes Claro Tv+, puedes ver L1MAX desde el canal 10 o 510.
  </p>
  <p class="tutorialPie movil" data-tab="L1MAX MOVIL">
    Luego de activar el beneficio, descarga la app de Claro video y disfruta los partidos desde tu celu.
  </p>

  <a
    href="https://www.clarovideo.com/peru/ligamax"
    title=""
    target="_blank"
    class="tutorialTabs-btn"
  >
    <span>Ingresa a Claro video aquí</span>
  </a>
</section>

<style>
  section.tutorialTabs {
    position: relative;
    background-color: #fafafa;
    padding: 40px 0;
  }

  section.tutorialTabs h2 {
    color: #000;
    text-align: center;
    font-family: AMX;
    font-size: 32px;
    font-weight: 700;
    line-height: normal;
    margin-bottom: 20px;
  }

  section.tutorialTabs h2 span {
    color: #da291c;
  }

  section.tutorialTabs .checks {
    background-color: #fff;
    display: grid;
    display: none;
    grid-template-columns: repeat(2, 1fr);
    padding: 30px;
    border-radius: 10px;
    box-shadow: 1px 1px 1px rgba(0, 0, 0, 0.1);
  }

  section.tutorialTabs .checks.active {
    display: grid !important;
  }

  section.tutorialTabs .checks div {
    display: flex;
    align-items: start;
    gap: 20px;
  }

  section.tutorialTabs .checks div p {
    color: #000;
    font-family: "AMX Regular";
    font-size: 14px;
    font-weight: 400;
    line-height: normal;
  }

  @media (min-width: 768px) {
    section.tutorialTabs .checks {
      gap: 20px;
      padding: 25px;
      max-width: 585px;
      margin: auto;
      margin-bottom: 80px;
    }
    section.tutorialTabs .checks[data-tab="L1 MAX"] {
      grid-template-columns: repeat(3, 1fr);
      max-width: 840px;
    }
  }

  section.tutorialTabs .selectTabs {
    display: none;
  }

  section.tutorialTabs a.tutorialTabs-btn {
    display: flex;
    gap: 6px;
    justify-content: center;
    align-items: center;
    margin: auto;
    margin-top: 50px;
    border-radius: 25px;
    background-color: #da291c;
    color: #fff;
    max-width: 240px;
    width: 100%;
    height: auto;
    padding: 8px 0;
    text-decoration: none;
    text-align: center;
    border-radius: 20px;
    font-size: 16px;
    font-family: "Roboto";
    font-weight: 700;
    background: linear-gradient(272deg, #b52217 0%, #da291c 100%);
    box-shadow:
      0 0px 10px 0 rgba(45, 45, 45, 0.1) inset,
      4px 4px 14px 0 rgba(255, 255, 255, 0.4) inset,
      0 4px 12px 0 rgba(131, 23, 15, 0.5);
    transform: scale(1);
    transition: all 0.3s ease-in-out;
  }

  section.tutorialTabs a.tutorialTabs-btn:hover {
    transform: scale(1.05);
  }

  #tutorial {
    position: absolute;
    top: -62px;
  }

  section.tutorialTabs p.intro {
    color: #000;
    text-align: center;
    font-feature-settings:
      "liga" off,
      "clig" off;
    font-family: Roboto;
    font-size: 16px;
    font-weight: 400;
    line-height: normal;
    max-width: 911px;
    margin: 0 auto;
    margin-bottom: 40px;
  }

  section.tutorialTabs .tabs {
    display: flex;
    align-items: stretch;
    border-radius: 28.5px;
    background: #fff;
    box-shadow: 0 0 8px 0 rgba(0, 0, 0, 0.25);
    justify-content: center;
    width: fit-content;
    margin: 0 auto;
    margin-bottom: 30px;
  }

  section.tutorialTabs .tabs .tab {
    color: #da291c;
    text-align: center;
    font-family: Roboto;
    font-size: 20px;
    font-weight: 700;
    line-height: normal;
    padding: 8px 0;
    width: 216px;
    cursor: pointer;
  }

  section.tutorialTabs .tabs .tab.active {
    border-radius: 114px;
    background: #da291c;
    color: #fff;
  }

  /* ── contentTutorial2 ── */
  .contentTutorial2 {
    max-width: 1162px;
    margin: 0 auto;
    gap: 80px;
    align-items: center;
    display: none;
  }

  .contentTutorial2 .swiper-wrapper {
    padding: 50px 0;
  }

  .contentTutorial2.active {
    display: flex;
  }

  .contentTutorial2 .part1 {
    width: calc(100% - 420px);
  }

  .contentTutorial2 .part2 .info {
    display: none;
  }

  .contentTutorial2 .part2 .info.active {
    display: block;
  }

  .contentTutorial2 .part1 .item img {
    max-width: 245px;
    width: 100%;
  }

  .contentTutorial2 .part2 {
    width: 340px;
    flex-shrink: 0;
  }

  .contentTutorial2 .swiper-slide img {
    transform: scale(0.8);
    opacity: 0.3;
    transition: 0.3s linear;
  }

  .contentTutorial2 .swiper-slide-active img {
    transform: scale(1);
    opacity: 1;
    box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 16px;
    border-radius: 40px;
  }

  .contentTutorial2 .part2 p.numero {
    color: #3c3c3c;
    font-family: "AMX Regular";
    font-size: 24px;
    font-weight: 400;
    line-height: normal;
  }

  .contentTutorial2 .part2 p.numero strong {
    font-family: AMX;
    font-size: 48px;
    font-weight: 700;
  }

  .contentTutorial2 .part2 p.titulo {
    color: #283342;
    font-family: Roboto;
    font-size: 25px;
    font-weight: 500;
    line-height: normal;
    margin-top: 25px;
  }

  .contentTutorial2 .part2 p.titulo a {
    color: #0093a3;
    text-decoration: underline;
  }

  .contentTutorial2 .part2 p.descripcion {
    color: #283342;
    font-family: Roboto;
    font-size: 14px;
    font-weight: 400;
    line-height: normal;
    padding-top: 20px;
  }

  .contentTutorial2 .part2 p.descripcion b {
    font-weight: 700;
  }

  .contentTutorial2 .part2 .flechas {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
  }

  .contentTutorial2 .part2 .flechas .swiper-button-prev,
  .contentTutorial2 .part2 .flechas .swiper-button-next {
    position: static;
    margin-top: 0;
    width: auto;
    height: auto;
  }

  .contentTutorial2 .part2 .flechas .swiper-button-prev::after,
  .contentTutorial2 .part2 .flechas .swiper-button-next::after {
    display: none;
  }

  .contentTutorial2 .part2 .flechas .swiper-button-prev svg {
    transform: scale(-1);
  }

  .contentTutorial2 .part2 .flechas .swiper-button-prev svg,
  .contentTutorial2 .part2 .flechas .swiper-button-next svg {
    fill: transparent;
  }

  .contentTutorial2 .part2 .flechas .swiper-button-disabled {
    filter: grayscale(1);
    opacity: 0.5;
  }

  /* ── tutorialPie ── */
  .tutorialPie {
    color: #283342;
    text-align: center;
    font-family: Roboto;
    font-size: 18px;
    font-weight: 400;
    line-height: normal;
    padding: 0 20px;
    display: none;
    margin-top: 30px;
  }

  .tutorialPie.active {
    display: block;
  }

  @media (max-width: 1440px) {
    .contentTutorial2 .part2 p.numero strong {
      font-size: 40px;
    }
    .contentTutorial2 .part2 p.titulo {
      font-size: 20px;
    }
    .contentTutorial2 .part2 .flechas .swiper-button-prev,
    .contentTutorial2 .part2 .flechas .swiper-button-next {
      width: 35px;
    }
    .contentTutorial2 .part2 .flechas .swiper-button-prev svg,
    .contentTutorial2 .part2 .flechas .swiper-button-next svg {
      width: 100%;
    }
    .contentTutorial2 .part2 .flechas {
      margin-top: 20px;
    }
    .contentTutorial2 {
      gap: 50px;
    }
  }

  @media (max-width: 1024px) {
    .contentTutorial2 .part1 .item img {
      max-width: 209px;
    }
    .contentTutorial2 .part2 {
      width: 223px;
    }
    .contentTutorial2 .part2 p.titulo {
      font-size: 18px;
      margin-top: 16px;
    }
    .contentTutorial2 .part2 p.numero strong {
      font-size: 32px;
    }
    .contentTutorial2 .part2 p.numero {
      font-size: 20px;
    }
    .contentTutorial2 .part2 .flechas {
      margin-top: 16px;
    }
    .contentTutorial2 {
      max-width: 500px;
    }
    .contentTutorial2 .part1 {
      width: calc(100% - 260px);
    }
    .contentTutorial2 {
      gap: 36px;
    }
    .contentTutorial2 .swiper-slide-active img {
      border-radius: 32px;
    }
    .contentTutorial2 .swiper-wrapper .item {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .contentTutorial2 .swiper-wrapper {
      padding: 20px 0 40px;
    }
    .contentTutorial2 .swiper-slide img {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media (max-width: 600px) {
    section.tutorialTabs .checks {
      grid-template-columns: repeat(1, 1fr);
      gap: 5px;
    }
    section.tutorialTabs .tabs .tab {
      font-size: 16px;
      width: 162px;
    }
  }

  @media (max-width: 500px) {
    section.tutorialTabs {
      padding: 20px 0;
    }
    .contentTutorial2 {
      gap: 10px;
    }
    .contentTutorial2 .part2 p.numero strong {
      font-size: 24px;
    }
    .contentTutorial2 .part2 p.numero {
      font-size: 16px;
    }
    .contentTutorial2 .part2 p.titulo {
      font-size: 14px;
      margin-top: 10px;
    }
    .contentTutorial2 .part2 .flechas {
      gap: 11px;
    }
    .contentTutorial2 .part2,
    .contentTutorial2 .part1 {
      width: 50%;
    }
    .contentTutorial2 .swiper-wrapper {
      padding: 10px 0 30px;
    }
    .tutorialPie {
      padding: 0;
      font-size: 14px;
    }
    .contentTutorial2 .swiper-wrapper .item {
      padding: 0 10px;
    }
    .contentTutorial2 .swiper-slide-active img,
    .contentTutorial2 .swiper-slide img {
      box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 10px;
      border-radius: 30px;
    }
  }

  @media (max-width: 450px) {
    .contentTutorial2 .swiper-slide-active img,
    .contentTutorial2 .swiper-slide img {
      border-radius: 27px;
    }
  }

  @media (max-width: 400px) {
    .contentTutorial2 .swiper-slide-active img,
    .contentTutorial2 .swiper-slide img {
      border-radius: 24px;
    }
  }

  @media (max-width: 380px) {
    .contentTutorial2 .swiper-slide-active img,
    .contentTutorial2 .swiper-slide img {
      border-radius: 21px;
    }
  }
</style>

<script>
  import Swiper from "swiper/bundle";

  const swiperHogar = new Swiper(".sliderTutorial22", {
    centeredSlides: true,
    slidesPerView: 3,
    navigation: {
      prevEl: document.querySelector(".contentTutorial2.hogar .swiper-button-prev") as HTMLElement,
      nextEl: document.querySelector(".contentTutorial2.hogar .swiper-button-next") as HTMLElement,
    },
    breakpoints: {
      0: { slidesPerView: 1 },
      1025: { slidesPerView: 3 },
    },
  });

  swiperHogar.on("slideChange", (swiper) => {
    document.querySelectorAll(".contentTutorial2.hogar .info").forEach((el, i) => {
      el.classList.toggle("active", i === swiper.activeIndex);
    });
  });

  const swiperMovil = new Swiper(".sliderTutorial2", {
    centeredSlides: true,
    slidesPerView: 3,
    navigation: {
      prevEl: document.querySelector(".contentTutorial2.movil .swiper-button-prev") as HTMLElement,
      nextEl: document.querySelector(".contentTutorial2.movil .swiper-button-next") as HTMLElement,
    },
    breakpoints: {
      0: { slidesPerView: 1 },
      1025: { slidesPerView: 3 },
    },
  });

  swiperMovil.on("slideChange", (swiper) => {
    document.querySelectorAll(".contentTutorial2.movil .info").forEach((el, i) => {
      el.classList.toggle("active", i === swiper.activeIndex);
    });
  });

  /** TABS PRINCIPALES */
  const tabs2 = document.querySelectorAll(".principal .tab");
  const checks = document.querySelectorAll(".checks");
  const selectTabs2 = document.querySelectorAll(".selectTabs");

  function activarSecciones(tabValue: string) {
    checks.forEach((c) => c.classList.remove("active"));
    document.querySelector(`.checks[data-tab="${tabValue}"]`)?.classList.add("active");

    selectTabs2.forEach((s) => s.classList.remove("active"));
    document.querySelector(`.selectTabs[data-tab="${tabValue}"]`)?.classList.add("active");

    document.querySelectorAll(".contentTutorial2").forEach((ct) => ct.classList.remove("active"));
    document.querySelector(`.contentTutorial2[data-tab="${tabValue}"]`)?.classList.add("active");

    document.querySelectorAll(".tutorialPie").forEach((p) => p.classList.remove("active"));
    document.querySelector(`.tutorialPie[data-tab="${tabValue}"]`)?.classList.add("active");
  }

  if (tabs2.length > 0) {
    activarSecciones(tabs2[0].getAttribute("data-tab") as string);
  }

  tabs2.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs2.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      activarSecciones(tab.getAttribute("data-tab") as string);
    });
  });

  /** EVENTO DESDE EXPERIENCIA.ASTRO */
  document.addEventListener("cambiarTutorialL1Max", ((event: CustomEvent) => {
    const tipoTab = event.detail.tipo;
    const titleSlider = document.getElementById("title_tutorial_slider");
    if (tipoTab === "L1 MAX") {
      titleSlider!.innerHTML = 'Sigue los pasos para activar <span class="text-claro">L1MAX</span>';
    }
    if (tipoTab === "L1MAX MOVIL") {
      titleSlider!.innerHTML = 'Sigue los pasos para activar <span class="text-claro">L1MAX Móvil</span>';
    }
    activarSecciones(tipoTab);
  }) as EventListener);
</script>
